# Copy to terraform.tfvars. Management HTTPS is globally reachable by default
# (0.0.0.0/0), as explicitly chosen for this evaluation lab.
# To restrict it later, set management_allowed_cidrs to trusted public CIDRs.
hostname               = "esxi-01"
initial_datastore_name = "datastore1"

# SAFETY GATES: leave false until checking current prices against the
# US$0.50/hour total budget, confirming the ESXi build and approving billing.
# Terraform cannot enforce a real-time billing cap.
enable_provisioning = false
approve_hourly_costs = false
confirm_esxi_image   = false

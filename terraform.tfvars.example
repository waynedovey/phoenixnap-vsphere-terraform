# Copy to terraform.tfvars. Your lab allows unrestricted ESXi management
# HTTPS by default, by explicit choice. Restrict it for real deployments.
hostname               = "esxi-01"
initial_datastore_name = "datastore1"

# SAFETY GATES: no new /29/server purchase until the previous ESXi host and
# its /30 block are deleted and the live SEA quote passes US$0.50/hour.
enable_provisioning            = false
approve_hourly_costs           = false
confirm_esxi_image             = false
confirm_previous_server_retired = false
maximum_hourly_usd             = 0.50

# The approved GLOBAL hourly /29 range SKU is pinned by default:
# public_ipv4_sku = "W0I2-DIVY-ZJVP"
# The 0.028 USD/hour quote covers the ENTIRE /29 range, not each IP.

enable_installer        = false
confirm_seattle_retired = false
confirm_esxi_image      = false
approve_hourly_costs    = false

esxi_type              = "s2.c2.large"
installer_type         = "s0.d1.small"
maximum_hourly_usd     = 1.00
management_allowed_cidrs = ["0.0.0.0/0"]


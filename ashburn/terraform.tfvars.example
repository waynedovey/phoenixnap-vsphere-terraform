# Independent state. This example never provisions anything.
# Last working ASH SKUs are examples only; check current stock and prices.
enable_esxi             = false
enable_installer        = false
confirm_seattle_retired = false
confirm_esxi_image      = false
approve_hourly_costs    = false

esxi_type              = "s2.c2.medium"
installer_type         = "s2.c1.small"
maximum_hourly_usd     = 1.00
management_allowed_cidrs = ["0.0.0.0/0"]

# VCSA ISO source. All settings are read automatically from this tfvars file
# by ashburn/scripts/vcsa.sh; no shell exports of the IP or SHA are required.
#
# This lab's third-party mirror and supplied SHA-256 have NOT been independently
# verified against the publisher; use only if you trust this source.
# Downloading a matching file proves integrity against the supplied checksum,
# not that the ISO is genuine.
#
# Option A: HTTPS source, downloaded directly onto the Ubuntu installer.
vcsa_iso_url        = "https://d.idc.ir/VMWare/8.0.3/VMware-VCSA-all-8.0.3-24022515.iso"
vcsa_iso_sha256     = "645fb3debfe33331fed5ffd9971d5286b070f412b56a523a78abdc7bece07e29"
vcsa_iso_local_path = ""
#
# Option B: no URL, Mac-hosted ISO upload:
#   vcsa_iso_url        = ""
#   vcsa_iso_local_path = "/Users/youruser/Downloads/VMware-VCSA-all-8.0.3-24022515.iso"
#   vcsa_iso_sha256     = "THE_SAME_INDEPENDENTLY_VERIFIED_SHA256"
#
# Do NOT set vcsa_iso_local_path to /opt/vcsa/media/...: that is the
# AUTOMATIC REMOTE DESTINATION on Ubuntu, not a local file on your Mac.
# When URL is used, leave vcsa_iso_local_path = "".

